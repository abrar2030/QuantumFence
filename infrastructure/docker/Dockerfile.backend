FROM python:3.11-slim-bookworm AS builder

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /build
COPY code/backend/requirements.txt .

RUN pip install --index-url ${TORCH_INDEX_URL} torch==2.3.1 torchvision==0.18.1 \
    && pip install -r requirements.txt


FROM python:3.11-slim-bookworm AS runtime

LABEL maintainer="QuantumFence Team" \
      description="QuantumFence AI-Powered Perimeter Defense Backend"

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 libgl1 libglib2.0-0 libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r -g 10001 qfuser \
    && useradd -r -u 10001 -g qfuser -m -d /home/qfuser -s /sbin/nologin qfuser

COPY --from=builder /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/code:/app/code/backend \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    MPLCONFIGDIR=/tmp/matplotlib \
    WORKERS=1

WORKDIR /app/code/backend

COPY code/ai_models /app/code/ai_models
COPY code/backend /app/code/backend

RUN mkdir -p snapshots recordings logs /app/code/ai_models/weights \
    && chown -R qfuser:qfuser /app

USER qfuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--log-level", "info", "--no-use-colors"]
